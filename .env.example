# AI Courtroom — Environment Variables
# Copy to .env and fill in real values for non-mock operation.

# ── RAG ──────────────────────────────────────────────────────────────────────
# Set to "true" to use retrieve_mock.py instead of the real B implementation.
USE_MOCK_RAG=true

# ── LLM ──────────────────────────────────────────────────────────────────────
# Set to "true" to skip real LLM calls (all agents return hard-coded valid JSON).
USE_MOCK_LLM=true

# LLM provider: "openai" | "anthropic" | "gemini" | "ollama"
LLM_PROVIDER=openai

# Model name understood by the selected provider.
LLM_MODEL=gpt-4o

# API key for the selected provider (ignored when USE_MOCK_LLM=true).
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# ── GRAPH ─────────────────────────────────────────────────────────────────────
# Set to "true" to use run_mock.py instead of the real graph (for Plan E dev).
USE_MOCK_GRAPH=false

# ── DATABASE / CHECKPOINTING ──────────────────────────────────────────────────
# Postgres connection string for LangGraph checkpointer.
# When unset, falls back to in-memory MemorySaver (no persistence across restarts).
# DATABASE_URL=postgresql://user:password@localhost:5432/courtroom

# ── CROSS-EXAMINATION ────────────────────────────────────────────────────────
# Hard cap on cross-examination rounds (default 3).
MAX_CROSS_EXAM_ROUNDS=3

# Minimum confidence-delta to continue cross-examination (below = convergence).
CROSS_EXAM_CONVERGENCE_THRESHOLD=0.02

# ── JUDGE ─────────────────────────────────────────────────────────────────────
# Default judge profile: "strict" | "balanced" | "skeptical"
DEFAULT_JUDGE_PROFILE=balanced
