# ─── Core ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Mock / Real switches ─────────────────────────────────────────────────────
# Set to false when the real implementations from members C/D or B are integrated.
USE_MOCK_GRAPH=false
USE_MOCK_RAG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Development (shared Plan A SQLite client)
DB_BACKEND=sqlite
DATABASE_URL=sqlite:///./courtroom.sqlite3
SQLITE_PATH=./courtroom.sqlite3

# Production (Member A — Supabase Postgres)
# DB_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/courtroom

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# ─── Public case search APIs ───────────────────────────────────────────────────
COURTLISTENER_API_KEY=
GOVINFO_API_KEY=

# ─── n8n internal service token (NOT a user JWT) ──────────────────────────────
N8N_SERVICE_TOKEN=CHANGE_ME_n8n_internal_token

# ─── Frontend URL (for redirect hints) ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
